# Environment Configuration Template (Keep real keys in .env which is git-ignored)

# Optional: External SMS Gateway API (Fast2SMS, Twilio, Gupshup)
VITE_SMS_GATEWAY_API_URL=
VITE_SMS_GATEWAY_API_KEY=

# Optional: AI Provider (Gemini / OpenAI API)
VITE_GEMINI_API_KEY=
VITE_OPENAI_API_KEY=

# App Environment
VITE_APP_ENV=development
